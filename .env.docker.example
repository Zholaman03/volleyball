# cp .env.docker.example .env  — сосын мәндерді толтырыңыз

# Домен (HTTPS автоматты қосылады). Бос қалдырсаңыз, тек HTTP :80 (сынақ үшін).
DOMAIN=

# Сайттың толық мекенжайы (домен болса https://домен)
APP_URL=http://localhost

# Ойындар өтетін жердің уақыт белдеуі (Бішкек үшін Asia/Bishkek)
TIMEZONE=Asia/Almaty

# Бос қалдырсаңыз, бірінші іске қосқанда өзі жасалып, томда сақталады
APP_KEY=
