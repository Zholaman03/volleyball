# Өндіріске арналған api/.env үлгісі. setup.sh осыдан .env жасайды (__...__ орындарын өзі толтырады).
# APP_KEY бос қалады: update.sh бірінші іске қосылғанда өзі жасайды. Оны кейін ЕШҚАШАН өзгертпеңіз.
APP_NAME="Волейбол"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=__APP_URL__
APP_TIMEZONE=__TIMEZONE__
APP_LOCALE=kk
APP_FALLBACK_LOCALE=kk
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite файлы git-тен тыс, сервердің жеке қалтасында тұрады (update.sh оны ешқашан тиіспейді)
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/volleyball/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
MAIL_MAILER=log
